# Copy to ops/eodhd-daily-update-5m.timer (drop the .example), then
# symlink or copy into /etc/systemd/system/ and `systemctl enable --now`.
# No host-specific paths in here (unlike the matching .service file) --
# this is gitignored alongside it mainly so the set stays together, and
# because OnCalendar= below assumes this VM's local timezone (check
# `timedatectl` on a new host and adjust the time if it's not
# America/New_York).

[Unit]
Description=Run eodhd-daily-update (intraday-price) on Sundays

[Timer]
# Sunday only -- kept on a separate day from the Saturday daily-bar fetch
# (eodhd-daily-update-1d.timer) so the two heavier EODHD-call-volume jobs
# don't compete for the same day's quota. 5-minute bars generate far more
# rows per ticker than daily bars, so this is also the more disk-hungry of
# the two -- see doc/DESIGN_DECISIONS.md ("weekday/Saturday/Sunday split").
OnCalendar=Sun *-*-* 04:00:00
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
