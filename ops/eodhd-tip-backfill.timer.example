# Copy to ops/eodhd-tip-backfill.timer (drop the .example), then symlink
# or copy into /etc/systemd/system/ and `systemctl enable --now`. No
# host-specific paths in here (unlike the matching .service file) --
# gitignored alongside it mainly so the set stays together. The
# Australia/Melbourne pin and run time are specific to this project's own
# backfill -- adjust for whoever is actually reviewing the logs.

[Unit]
Description=Run eodhd-tip-backfill on weekdays until the historical gap is closed

[Timer]
# Weekdays only -- the backfill script itself no-ops on a calendar window
# with no emails in it (weekends), but there's no reason to even spin up
# the batch on a day nothing will be found. Pin an explicit IANA timezone
# (not whatever this VM's own system timezone happens to be) so the run
# time tracks the right person's local time and DST, not the server's.
# See doc/DESIGN_DECISIONS.md ("historical tip backfill").
OnCalendar=Mon,Tue,Wed,Thu,Fri *-*-* 04:00:00 Australia/Melbourne
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
