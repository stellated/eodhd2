# Copy to ops/daily-update.env and edit for this machine.
# ops/daily-update.env itself is gitignored -- it holds no secrets (those
# stay in the repo-root .env that scripts/daily_update.py loads directly),
# just machine-specific paths.

# rclone remote:path for the canonical database, as set up via `rclone config`
# (see readme/ops notes for the OneDrive setup steps).
RCLONE_REMOTE=onedrive:eodhd/prod.db

# Local scratch directory used while the job runs. Deleted after each
# successful run -- nothing here is meant to persist on this VM.
WORK_DIR=/var/tmp/eodhd-daily-update

# ops/run_ig_margins.sh only: where the raw monthly IG tiered-margin
# spreadsheet (every country, not just AU/US) is archived, for continuity
# with its predecessor's monthly archive on the old "nebula" machine --
# see doc/DESIGN_DECISIONS.md ("IG tiered margins"). This is the same
# folder nebula's own archive already lives in.
IG_ARCHIVE_RCLONE_REMOTE=onedrive:Data/StockDataAnalytics/mars/tiered
