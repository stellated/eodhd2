# Copy to ops/eodhd-daily-update-1d.timer (drop the .example), then
# symlink or copy into /etc/systemd/system/ and `systemctl enable --now`.
# No host-specific paths in here (unlike the matching .service file) --
# this is gitignored alongside it mainly so the set stays together, and
# because OnCalendar= below assumes this VM's local timezone (check
# `timedatectl` on a new host and adjust the time if it's not
# America/New_York).

[Unit]
Description=Run eodhd-daily-update (all-price) on Saturdays

[Timer]
# Saturday: the same all-price run as weekdays (see the .service), which
# picks up Friday's session and takes the weekly db snapshot -- see
# doc/DESIGN_DECISIONS.md ("price fetch every day: --mode all-price").
# There's no before-market-open constraint on a non-trading day, so this
# could move if it ever needs to.
OnCalendar=Sat *-*-* 04:00:00
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
