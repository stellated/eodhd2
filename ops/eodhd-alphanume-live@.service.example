# Copy to ops/eodhd-alphanume-live@.service (drop the .example), edit the
# User=/WorkingDirectory=/ExecStart= paths for this machine, then symlink
# or copy into /etc/systemd/system/. Instances are job names from
# scripts/get_alphanume.py's JOBS, e.g. eodhd-alphanume-live@ndm.service;
# the eodhd-alphanume-*.timer files start them. Gitignored because of the
# host-specific paths. Only for the alphanume trial: disable the timers
# afterwards (see DAProjects/Alphanume Trial Plan.md).

[Unit]
Description=Alphanume live capture: %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/repos/eodhd2
ExecStart=/home/YOUR_USERNAME/repos/eodhd2/ops/run_alphanume.sh live %i
