# Copy to ops/eodhd-ig-margins.timer (drop the .example), then symlink or
# copy into /etc/systemd/system/ and `systemctl enable --now`. No
# host-specific paths in here (unlike the matching .service file) --
# gitignored alongside it mainly so the set stays together.

[Unit]
Description=Run eodhd-ig-margins daily

[Timer]
# Daily (Ian, 2026-10-28): IG regenerates the file every day, about
# 23:00 UTC, and keeps no past versions, so a day not downloaded is lost.
# 21:00 New York is after that in both EDT and EST, and clear of the
# 04:00 tips/price runs. A run that finds no new version pushes nothing.
OnCalendar=*-*-* 21:00:00
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
