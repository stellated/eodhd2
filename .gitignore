.DS_Store
.env
*.db
__pycache__/
.venv/
.idea/
.pytest_cache/
.hypothesis/
.claude/

ops/daily-update.env
# All three weekday/Saturday/Sunday unit pairs -- host-specific (absolute
# path, User=) so none of them are tracked, same as the original pair.
ops/eodhd-daily-update*.service
ops/eodhd-daily-update*.timer
# Same reasoning for the disk-space-alert unit pair.
ops/eodhd-disk-space-alert.service
ops/eodhd-disk-space-alert.timer
# Same reasoning for the one-time tip-backfill unit pair.
ops/eodhd-tip-backfill.service
ops/eodhd-tip-backfill.timer
# Host-specific backfill progress (which batch comes next) -- not
# meaningful to share/commit.
ops/backfill_state
# Same reasoning for the monthly IG tiered-margin unit pair.
ops/eodhd-ig-margins.service
ops/eodhd-ig-margins.timer

# Personal data captured for local inspection, not project source.
# One directory-level rule covers every current and future file in the
# tree (eml/html/csv, any new dated files) with zero ongoing maintenance --
# no need to add a new pattern each time a new file type or date shows up.
scripts/data/

# alphanume trial units (host-specific paths), templates tracked as .example
ops/eodhd-alphanume-live@.service
ops/eodhd-alphanume-*.timer
